<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>NatureOS.MINDEX</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>NatureOS MINDEX - Multi-Model Database Schema</Title>
    <Description>Data models and schemas for the NatureOS MINDEX multi-model database</Description>
    <Authors>Mycosoft Labs</Authors>
    <Company>Mycosoft Labs</Company>
    <Product>NatureOS</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.36.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="FluentValidation" Version="11.8.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project> 