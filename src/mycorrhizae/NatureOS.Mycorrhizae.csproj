<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>NatureOS.Mycorrhizae</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>NatureOS Mycorrhizae Protocol</Title>
    <Description>Event processing and protocol implementation for the NatureOS Mycorrhizae Protocol</Description>
    <Authors>Mycosoft Labs</Authors>
    <Company>Mycosoft Labs</Company>
    <Product>NatureOS</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.EventGrid" Version="4.19.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="FluentValidation" Version="11.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../mindex/NatureOS.MINDEX.csproj" />
  </ItemGroup>

</Project> 