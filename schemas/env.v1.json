{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.natureos.ai/env.v1.json",
  "title": "Environmental Telemetry v1",
  "type": "object",
  "properties": {
    "data_type": { "const": "env.v1" },
    "schema_version": { "type": "string", "const": "1" },
    "timestamp": { "type": "string", "format": "date-time" },
    "device_id": { "type": "string" },
    "temperature_c": { "type": "number" },
    "humidity_percent": { "type": "number" },
    "pressure_hpa": { "type": "number" },
    "gas_resistance_kohm": { "type": "number" },
    "location": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy_m": { "type": "number" }
      },
      "required": ["latitude", "longitude"]
    }
  },
  "required": ["data_type", "schema_version", "timestamp", "device_id"]
}
