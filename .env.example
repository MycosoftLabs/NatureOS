# =============================================================================
# NatureOS - Environment Variables Template
# =============================================================================
# Copy this file to .env (or configure in your service manager) and fill real values.
# NEVER commit .env to git. Only .env.example should be in version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Downstream services
# -----------------------------------------------------------------------------
MINDEX_API_URL=http://192.168.0.189:8000
MINDEX_API_KEY=your-mindex-service-api-key

# Optional: NCBI + ChemSpider (used by ingestion services / downstream tools)
NCBI_API_KEY=your-ncbi-api-key
CHEMSPIDER_API_KEY=your-chemspider-api-key